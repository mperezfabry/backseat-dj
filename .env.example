# ───────────── Required ─────────────

# The public HTTPS address riders open (no trailing slash). Examples:
#   Tailscale Funnel:  https://backseat-dj.your-tailnet.ts.net
#   Your own domain:   https://dj.example.com
PUBLIC_URL=https://backseat-dj.your-tailnet.ts.net

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Protects the driver's /admin page. Generate one with:  openssl rand -base64 18
ADMIN_PASSWORD=

# ───────────── How riders reach it (pick one, see README) ─────────────

# Option A: Tailscale Funnel (free, no domain needed)
# COMPOSE_PROFILES=tailscale
# TS_AUTHKEY=tskey-auth-...

# Option B: Cloudflare Tunnel (needs a domain on Cloudflare)
# COMPOSE_PROFILES=cloudflare
# CLOUDFLARE_TUNNEL_TOKEN=

# Option C: your own reverse proxy (Caddy, nginx, Traefik...) pointed at this port
# HOST_PORT=8787

# ───────────── Optional tuning (defaults shown) ─────────────
# SONG_LIMIT=5
# DOUBLE_SKIP_WINDOW_SECONDS=20
# RIDE_IDLE_MINUTES=20
# RIDE_MAX_MINUTES=180
